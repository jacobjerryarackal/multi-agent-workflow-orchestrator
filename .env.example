# Application Configuration
APP_NAME=MultiAgentWorkflowOrchestrator
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestrator_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Google Gemini API Provider
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL_NAME=gemini-2.5-flash
REASONING_MODEL_NAME=gemini-2.5-pro

# Orchestration Limits & Invariants
MAX_WORKFLOW_DURATION_SECONDS=600
MAX_TASK_DURATION_SECONDS=60
MAX_PARALLEL_TASKS=5
MAX_TASK_RETRIES=3
