# ==============================================================================
# Multi-Agent Workflow Orchestrator - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Settings
# ------------------------------------------------------------------------------
APP_NAME=MultiAgentWorkflowOrchestrator
APP_ENV=development                       # Options: development, staging, production
LOG_LEVEL=INFO                           # Options: DEBUG, INFO, WARNING, ERROR
DEBUG=false                              # Set false in production

# ------------------------------------------------------------------------------
# 2. Server & Networking Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated allowed CORS origins (Include Vercel production and preview URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# 3. PostgreSQL Persistence & Connection Pool (Backend Secret)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orchestrator_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 4. Google Gemini LLM Provider (Backend Secret - NEVER expose to frontend)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL_NAME=gemini-2.5-flash
REASONING_MODEL_NAME=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 5. Orchestration Limits & Invariants
# ------------------------------------------------------------------------------
MAX_WORKFLOW_DURATION_SECONDS=600
MAX_TASK_DURATION_SECONDS=60
MAX_PARALLEL_TASKS=5
MAX_TASK_RETRIES=3
MAX_TOTAL_WORKFLOW_STEPS=50
MAX_OUTPUT_SIZE_BYTES=1048576             # 1 MB
MAX_REQUEST_SIZE_BYTES=10485760           # 10 MB

# ------------------------------------------------------------------------------
# 6. Rate Limiting Configuration (Process-Local Sliding Window)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ------------------------------------------------------------------------------
# 7. Frontend Deployment Configuration (Vercel Environment)
# ------------------------------------------------------------------------------
# URL of the deployed FastAPI backend on Render (used by Next.js API proxy)
BACKEND_API_URL=https://your-backend-api.onrender.com
